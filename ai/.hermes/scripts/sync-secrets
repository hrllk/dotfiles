#!/usr/bin/env bash
set -euo pipefail

KEY_DIR="${DOTFILES_KEY_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/task/keys}"
TARGET="${HERMES_LAUNCHD_ENV:-$HOME/.hermes/.launchd.env}"

secret_value() {
  tr -d '\r\n' < "$1"
}

shopt -s nullglob
secret_files=(
  "$KEY_DIR"/personal/discord/discord-bot-token-*
  "$KEY_DIR"/personal/discord/discord-user-id-*
)
(( ${#secret_files[@]} > 0 )) || {
  printf 'No Hermes Discord secret files found under: %s\n' "$KEY_DIR/personal/discord" >&2
  exit 1
}

for secret_file in "${secret_files[@]}"; do
  [[ -r "$secret_file" ]] || {
    printf 'Hermes secret file is not readable: %s\n' "$secret_file" >&2
    exit 1
  }
done

mkdir -p "$(dirname "$TARGET")"
umask 077
tmp_file="$(mktemp "${TARGET}.tmp.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT

{
  for secret_file in "${secret_files[@]}"; do
    filename="${secret_file##*/}"
    variable="${filename#discord-}"
    variable="DISCORD_${variable//-/_}"
    variable="$(printf '%s' "$variable" | tr '[:lower:]' '[:upper:]')"
    value="$(secret_value "$secret_file")"
    [[ -n "$value" ]] || {
      printf 'Hermes secret file is empty: %s\n' "$secret_file" >&2
      exit 1
    }
    printf 'export %s=%q\n' "$variable" "$value"
  done
} > "$tmp_file"

grep -q '^export DISCORD_USER_ID_ALZAR=' "$tmp_file"
grep -q '^export DISCORD_BOT_TOKEN_DEFAULT=' "$tmp_file"

chmod 600 "$tmp_file"
mv -f "$tmp_file" "$TARGET"
trap - EXIT
printf 'Hermes secrets synced: %s\n' "$TARGET"
