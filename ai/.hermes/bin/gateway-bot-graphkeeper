#!/bin/zsh
set -eu

LAUNCHD_ENV="/Users/hrk/.hermes/.launchd.env"
HERMES_PYTHON="/Users/hrk/.hermes/hermes-agent/venv/bin/python"

[[ -r "$LAUNCHD_ENV" ]]
source "$LAUNCHD_ENV"
export DISCORD_BOT_TOKEN="$DISCORD_BOT_TOKEN_GRAPHKEEPER"
export DISCORD_ALLOWED_USERS="$DISCORD_USER_ID_ALZAR"

[[ -n "$DISCORD_BOT_TOKEN_GRAPHKEEPER" && -n "$DISCORD_USER_ID_ALZAR" ]]

exec "$HERMES_PYTHON" -m hermes_cli.main --profile bot-graphkeeper gateway run --replace
