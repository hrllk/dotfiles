{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hrk/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.tmux/scripts/ai-notify-hook.sh Claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.tmux/scripts/ai-notify-hook.sh Claude waiting",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "tui": "default",
  "theme": "dark",
  "editorMode": "vim",
  "autoScrollEnabled": true
}
