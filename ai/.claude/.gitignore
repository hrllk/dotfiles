# Ignore Claude Code runtime state by default. Only the entries below are tracked.
*

!.gitignore
!README.md
!CLAUDE.md
!settings.json
!keybindings.json

!agents/
!agents/**/
!agents/**/*.md

!commands/
!commands/**/
!commands/**/*.md

!output-styles/
!output-styles/*.md

!hooks/
!hooks/**/
!hooks/**/*.sh
!hooks/**/*.mjs
!hooks/**/*.js
!hooks/**/*.py

!scripts/
!scripts/*

!skills/
!skills/**/
!skills/**/*.md
!skills/**/*.sh
!skills/**/*.mjs
!skills/**/*.js
!skills/**/*.py
!skills/**/*.json
!skills/**/*.yaml
!skills/**/*.yml

!plugins/
!plugins/config.json

# Externally installed skills stay untracked; their upstream tool owns them.
skills/.system/
skills/gstack
skills/gstack-*
skills/_gstack-command/

# Never commit credentials or machine-local overrides.
.credentials.json
*.credentials.json
settings.local.json
.last-update-result.json
policy-limits.json
remote-settings.json
