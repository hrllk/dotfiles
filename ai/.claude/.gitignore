# Ignore Claude Code runtime state by default. Only the entries below are tracked.
*

!.gitignore
!README.md
!CLAUDE.md
!settings.json
!keybindings.json

!agents/
!agents/**/
!agents/**/*.md

!commands/
!commands/**/
!commands/**/*.md

!output-styles/
!output-styles/*.md

!hooks/
!hooks/**/
!hooks/**/*.sh
!hooks/**/*.mjs
!hooks/**/*.js
!hooks/**/*.py

!scripts/
!scripts/*

!skills/
!skills/**/
!skills/**/*.md
!skills/**/*.sh
!skills/**/*.mjs
!skills/**/*.js
!skills/**/*.py
!skills/**/*.json
!skills/**/*.yaml
!skills/**/*.yml

!plugins/
!plugins/config.json

# Externally installed skills stay untracked; their upstream tool owns them.
# gstack installs its suite here as symlinks into /Users/hrk/gstack-open -- 101
# of them at last count -- so tracking the tree would commit absolute paths that
# resolve on no other machine, and break on this one the moment that checkout
# moves. Everything currently under skills/ belongs to gstack.
#
# This ignores the directory, so git does not descend into it. To track a
# hand-written skill later, re-allow the directory before the file:
#   !skills/my-skill/
#   !skills/my-skill/**
skills/

# Never commit credentials or machine-local overrides.
.credentials.json
*.credentials.json
settings.local.json
.last-update-result.json
policy-limits.json
remote-settings.json
