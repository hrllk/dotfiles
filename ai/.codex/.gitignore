# Ignore Codex runtime state by default. Only the entries below are tracked.
#
# The upstream harness-for-codex template assets (LICENSE, CHANGELOG, docs/,
# tasks/, .github/, .devcontainer/, harness.yml, justfile, scripts/*) are
# deliberately NOT tracked. They are a project scaffold; nothing executes them
# from a tool home directory. Clone the harness into a project when you need it.
*

!.gitignore
!AGENTS.md
!CLAUDE.md
!local.config.toml.example
!codex-profile-check
!init-home-codex
!hooks.json

!hooks/
!hooks/**/
!hooks/**/*.mjs
!hooks/**/*.js
!hooks/**/*.sh
!hooks/**/*.py

!skills/
!skills/**/
!skills/**/.gitignore
!skills/**/*.md
!skills/**/*.json
!skills/**/*.yaml
!skills/**/*.yml
!skills/**/*.sh
!skills/**/*.mjs
!skills/**/*.js
!skills/**/*.py
!skills/**/*.html

# Externally installed skills stay untracked; their upstream tool owns them.
skills/.system/
skills/gstack
skills/gstack-*

# config.toml is written by the ChatGPT desktop app, not by hand: it rewrites
# MCP server registrations, the plugin marketplace, [desktop] preferences and a
# pinned build number on every launch. Tracking it meant a dirty tree after each
# run and a diff that said nothing about how this machine is set up on purpose.
# A fresh machine gets Codex's own defaults; set model and approvals there by
# hand, or keep them in local.config.toml.
config.toml

# Never commit credentials or machine-local overrides.
auth.json
oauth*.json
local.config.toml
.credentials.json
