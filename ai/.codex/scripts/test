#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -f package.json ]] && npm run | grep -qE '^  test$'; then
  npm test
elif [[ -f Cargo.toml ]]; then
  cargo test
elif [[ -d tests ]] && command -v pytest >/dev/null 2>&1; then
  pytest
else
  echo "No known test suite found."
fi

# The tmux unread indicator is shared with Claude Code, so its test lives in
# the dotfiles repo. Skip silently when the harness runs outside that checkout.
TMUX_UNREAD_TEST="${DOTFILES_DIR:-$HOME/dotfiles}/scripts/tests/tmux-unread-test.sh"
if [[ -x "$TMUX_UNREAD_TEST" ]]; then
  "$TMUX_UNREAD_TEST"
fi
